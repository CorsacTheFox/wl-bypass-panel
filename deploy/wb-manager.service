[Unit]
Description=Whitelist-Bypass Instance Manager (FastAPI/uvicorn)
Documentation=https://github.com/kulikov0/whitelist-bypass
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated, unprivileged service account (created by install.sh).
User={{SERVICE_USER}}
Group={{SERVICE_USER}}

# Where the app lives (created by install.sh).
WorkingDirectory={{APP_DIR}}

# Load secrets/overrides from here (created by install.sh from .env.example).
EnvironmentFile=-{{APP_DIR}}/.env

# Run inside the venv. Bound to 127.0.0.1 — the reverse proxy fronts it.
# Host/port are rendered by install.sh from .env (WB_HOST / WB_PORT), so they
# can be changed without editing this unit — re-run the installer to update.
ExecStart={{APP_DIR}}/.venv/bin/python -m uvicorn main:app \
    --host {{APP_HOST}} --port {{APP_PORT}} --workers 1

Restart=on-failure
RestartSec=3

# Hardening (uvicorn + sqlite need none of the following, so deny them).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Output -> journald (view with: journalctl -u wb-manager -f).
StandardOutput=journal
StandardError=journal

# Stop/restart must NOT take the spawned proxy binaries down with the manager.
# KillMode=process => systemd signals ONLY the uvicorn main process; the child
# binaries (started with start_new_session=True, i.e. their own session/pgid)
# keep running and the app re-adopts them on startup (main.py reattach()).
# This is what lets `systemctl restart` / an update leave live instances alone.
TimeoutStopSec=15
KillMode=process
KillSignal=SIGINT
FinalKillSignal=SIGKILL
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
