# Whitelist-Bypass Instance Manager — environment overrides.
# Copy to .env and edit. The systemd unit loads this via EnvironmentFile.

# ---- Server bind ----
WB_HOST=127.0.0.1
WB_PORT=8000

# ---- Bootstrap admin (created only on FIRST run, while no admin exists) ----
WB_ADMIN_USERNAME=admin
WB_ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Storage ----
WB_DATA_DIR=/opt/whitelist-manager/data
WB_BINARIES_DIR=/opt/whitelist-manager/binaries
WB_DATABASE_PATH=/opt/whitelist-manager/data/app.db

# ---- Policy ----
WB_DEFAULT_MAX_CONCURRENT=3
# Default instance lifetime (seconds) — also the post-claim lifetime for the
# Android-app flow. 300 = 5 minutes. Unauthorized users are hard-capped here.
WB_DEFAULT_TIMEOUT_SECONDS=300
WB_KILL_GRACE_SECONDS=5
WB_SESSION_TTL=43200

# ---- Quick Launch ----
# Shared secret token for the /quick page. Leave empty to disable.
# Access: https://your-domain.com/quick?token=YOUR_TOKEN
WB_QUICK_TOKEN=

# ---- Android App API (/api/app/*) ----
# Static shared secret the Android app sends in the X-App-Token header to use
# the standalone instance-creation flow. Leave empty to disable the whole
# /api/app router (every endpoint returns 404). Generate with: openssl rand -hex 32
WB_APP_TOKEN=

# VK relay fallback: lets the Android app fetch a temporary link via the VK
# Messages API when beta.cors-fox.cc AND the Yandex Function proxy are both
# unreachable under a carrier whitelist. Leave both empty to disable the loop
# (default). See vk_relay.py for setup steps.
WB_VK_COMMUNITY_TOKEN=
WB_VK_RELAY_PEER_ID=

# Android App Links verification (/.well-known/assetlinks.json). Android 15+/16
# refuse to open the https://<domain>/tginit App Link unless this statement is
# served and matches the app's signing cert (Android 12 was lenient). Defaults
# are the Cors.Connect app; update the fingerprint if the signing key changes.
# Get it: keytool -list -v -keystore <keystore> | grep SHA256
WB_APP_PACKAGE=cc.cors.connect
WB_APP_CERT_SHA256=AB:E4:6D:43:49:90:68:5A:91:34:70:69:A7:42:FA:7C:9D:D3:77:2D:80:CF:D1:57:05:4A:4D:15:E9:00:DA:4D
# Lifetime (seconds) of an unauthenticated temporary instance created by the
# app, during which the user must complete Telegram authorization. 300 = 5 min.
# Unauthorized users can never extend beyond this.
WB_APP_TEMP_TIMEOUT=300
# Heartbeat extension for AUTHORIZED users (can_create_instances=1 / admin).
# Each heartbeat adds WB_HEARTBEAT_EXT seconds, capped at WB_HEARTBEAT_MAX from
# now. 300 / 3600 = +5 min per beat, up to a 1-hour ceiling. Unauthorized users
# are rejected at the heartbeat endpoint (403) and cannot extend at all.
WB_HEARTBEAT_EXT=300
WB_HEARTBEAT_MAX=3600

# ---- Telegram (WebApp / Mini App) login ----
# Bot token from BotFather. Enables POST /api/auth/telegram and the app claim
# flow. Leave empty to disable Telegram auth (both return 404).
WB_TELEGRAM_BOT_TOKEN=
# Max age (seconds) of a Telegram initData string before it is rejected.
WB_TG_INITDATA_MAX_AGE=86400

# ---- Remnawave integration (Admin → Remnawave) ----
# Source panel for the user import (squads → local clients). These are only
# FALLBACK defaults — the URL/key are normally set in the admin UI (stored in
# the settings table). Leave both empty to configure purely from the UI.
WB_REMNAWAVE_PANEL_URL=
WB_REMNAWAVE_API_KEY=
# Per-request HTTP timeout against the panel (seconds).
WB_REMNAWAVE_TIMEOUT=15
# Default auto-sync interval (minutes) when nothing is stored in the DB yet.
WB_REMNAWAVE_SYNC_INTERVAL=30
