# Whitelist-Bypass Instance Manager — environment overrides.
# Copy to .env and edit. The systemd unit loads this via EnvironmentFile.

# ---- Server bind ----
WB_HOST=127.0.0.1
WB_PORT=8000

# ---- Bootstrap admin (created only on FIRST run, while no admin exists) ----
WB_ADMIN_USERNAME=admin
WB_ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Storage ----
WB_DATA_DIR=/opt/whitelist-manager/data
WB_BINARIES_DIR=/opt/whitelist-manager/binaries
WB_DATABASE_PATH=/opt/whitelist-manager/data/app.db

# ---- Policy ----
WB_DEFAULT_MAX_CONCURRENT=3
WB_DEFAULT_TIMEOUT_SECONDS=3600
WB_KILL_GRACE_SECONDS=5
WB_SESSION_TTL=43200

# ---- Quick Launch ----
# Shared secret token for the /quick page. Leave empty to disable.
# Access: https://your-domain.com/quick?token=YOUR_TOKEN
WB_QUICK_TOKEN=

# ---- Android App API (/api/app/*) ----
# Static shared secret the Android app sends in the X-App-Token header to use
# the standalone instance-creation flow. Leave empty to disable the whole
# /api/app router (every endpoint returns 404). Generate with: openssl rand -hex 32
WB_APP_TOKEN=
# Lifetime (seconds) of an unauthenticated temporary instance created by the
# app, during which the user must complete Telegram authorization. Default 600.
WB_APP_TEMP_TIMEOUT=600

# ---- Telegram (WebApp / Mini App) login ----
# Bot token from BotFather. Enables POST /api/auth/telegram and the app claim
# flow. Leave empty to disable Telegram auth (both return 404).
WB_TELEGRAM_BOT_TOKEN=
# Max age (seconds) of a Telegram initData string before it is rejected.
WB_TG_INITDATA_MAX_AGE=86400
