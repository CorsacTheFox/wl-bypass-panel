# Whitelist-Bypass Instance Manager — environment overrides.
# Copy to .env and edit. The systemd unit loads this via EnvironmentFile.

# ---- Server bind ----
WB_HOST=127.0.0.1
WB_PORT=8000

# ---- Bootstrap admin (created only on FIRST run, while no admin exists) ----
WB_ADMIN_USERNAME=admin
WB_ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Storage ----
WB_DATA_DIR=/opt/whitelist-manager/data
WB_BINARIES_DIR=/opt/whitelist-manager/binaries
WB_DATABASE_PATH=/opt/whitelist-manager/data/app.db

# ---- Policy ----
WB_DEFAULT_MAX_CONCURRENT=3
WB_DEFAULT_TIMEOUT_SECONDS=3600
WB_KILL_GRACE_SECONDS=5
WB_SESSION_TTL=43200

# ---- Quick Launch ----
# Shared secret token guarding the unauthenticated /quick and /api/quick/* flow
# (the "regular temporary link" an unauthorized client receives). Leave EMPTY to
# leave the flow fully public (dev). When set, callers must pass it as the
# X-Api-Key header or ?token= query param.
WB_QUICK_TOKEN=

# ---- Native Android app (authorized clients) ----
# Instance lifetime for the authorized connect flow (GET /api/app/connect).
# Long by default so the link lives for the whole connection. Default 24h.
WB_APP_DEFAULT_TIMEOUT_SECONDS=86400

# ---- Telegram authorization ----
# Bot token from BotFather. Enables POST /api/auth/telegram (returns 404 if empty).
WB_TELEGRAM_BOT_TOKEN=
# Public bot username (without '@') advertised at GET /api/config for the app.
# Leave empty to not advertise (the app must then be configured out-of-band).
WB_TELEGRAM_BOT_USERNAME=
# 1 = auto-grant instance-creation privilege to Telegram-auto-created users
#     (so the app works out-of-the-box). 0 = admin must grant per user.
WB_TELEGRAM_AUTO_CAN_CREATE=0
WB_TG_INITDATA_MAX_AGE=86400
